# Copie para .env e troque a senha. Nunca commite o .env.
POSTGRES_USER=comunica
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=comunica
POSTGRES_PORT=5450

DATABASE_URL=postgres://comunica:troque-esta-senha@localhost:5450/comunica?sslmode=disable
TEST_DATABASE_URL=postgres://comunica:troque-esta-senha@localhost:5450/comunica_test?sslmode=disable

PORT=8090
# Login com Discord (ver README: "App do Discord"). Sem as quatro DISCORD_* da API, ela não sobe.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:3000/api/auth/discord/callback
DISCORD_GUILD_ID=
# Opcional: ids dos cargos Admin e Moderação do servidor, separados por vírgula. Quem tem um deles apaga qualquer ideia e edita ou apaga qualquer evento.
DISCORD_MOD_ROLE_IDS=
# Opcional: bot que cria a call do grupo quando a ideia vai para Em andamento (ver README, passo 5). Com o token, a categoria é obrigatória.
DISCORD_BOT_TOKEN=
DISCORD_CALLS_CATEGORY_ID=
# Lido pelo front: convite mostrado para quem tenta entrar sem estar no servidor.
DISCORD_INVITE_URL=
# Opcional, lido pelo front: onde ele acha a API Go (padrão http://localhost:8090).
# API_URL=http://localhost:8090
